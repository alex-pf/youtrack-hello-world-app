# Copy this file to scripts/data-gen/.env.local (gitignored) and fill in real
# values. Used by plan.mjs and run.mjs.
#
#   cp scripts/data-gen/.env.local.example scripts/data-gen/.env.local
#   node --env-file=scripts/data-gen/.env.local scripts/data-gen/plan.mjs

# YouTrack Cloud instance the generator writes synthetic issues into.
# MUST be a test/sandbox instance — never point this at a production project.
YOUTRACK_BASE_URL=https://your-instance.youtrack.cloud
YOUTRACK_TOKEN=

# Anthropic API key for the nightly planning call (cheap model, see
# config.json "ai.model" — defaults to claude-haiku-4-5).
ANTHROPIC_API_KEY=
